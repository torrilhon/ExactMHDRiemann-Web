{
  "name": "exactmhdriemann-web",
  "version": "0.0.0",
  "private": true,
  "description": "Exact Riemann solver for ideal MHD in the browser: TypeScript port of ExactMHDRiemannSolver.jl",
  "license": "MIT",
  "author": "Manuel Torrilhon",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torrilhon/ExactMHDRiemann-Web.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:numerics": "node scripts/lint-numerics.mjs",
    "check": "npm run typecheck && npm run lint:numerics && npm run test && npm run build",
    "fuzz": "node --experimental-strip-types scripts/fuzz.mts",
    "compare-golden": "node --experimental-strip-types scripts/compare-golden.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "ml-matrix": "^6.15.0",
    "smol-toml": "^1.9.0",
    "uplot": "^1.6.32"
  }
}
